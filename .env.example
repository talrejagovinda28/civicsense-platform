# Supabase PostgreSQL (Database only — not Auth or Storage)
# Use the URI from Supabase → Project Settings → Database → Connection string
# Append ?sslmode=require if not already present
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://YOUR_CLERK_DOMAIN.clerk.accounts.dev/.well-known/jwks.json
# Optional but recommended in production — Frontend API URL (issuer claim)
CLERK_ISSUER=https://YOUR_CLERK_DOMAIN.clerk.accounts.dev
# Backend uses CLERK_SECRET_KEY for admin role updates via Clerk API

# Required for Clerk production proxy on Vercel (Domains → Proxy configuration)
NEXT_PUBLIC_CLERK_PROXY_URL=https://civicsense-platform.vercel.app/__clerk/

# Clerk frontend routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Cloudinary — enable signed uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=civicsense/complaints

# CivicSense backend environment (production|development|test)
ENVIRONMENT=production
CIVICSENSE_ALLOW_FAKE_ADAPTERS=false

# CivicSense India — outbound dispatch (keep false until channel matrix approved)
EXTERNAL_DISPATCH_GLOBAL_ENABLED=false
OFFICIAL_CHANNELS_REQUIRE_APPROVAL=true
CIVICSENSE_ENABLE_OUTBOUND_DRY_RUN=true

# Optional future channel credentials (DO NOT set / DO NOT enable without verified agency permission)
# MAIL_PROVIDER_API_KEY=
# MAIL_FROM_ADDRESS=
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_SENDER_ID=
